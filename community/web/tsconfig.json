{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "lib": ["ES2023", "DOM"],
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "noEmit": true, "types": ["vite/client"], "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
